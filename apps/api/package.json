{
  "name": "@pulseflow/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import ./node_modules/tsx/dist/loader.mjs --watch src/server.ts",
    "e2e:server": "tsx ../../tests/e2e/fixtures/api-server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/db/schema.sql', 'dist/db/schema.sql')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts apps/api/test",
    "coverage": "vitest run --coverage --config ../../vitest.config.ts apps/api/test"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@pulseflow/contracts": "workspace:*",
    "@pulseflow/model-adapter": "workspace:*",
    "@pulseflow/page-generator": "workspace:*",
    "@pulseflow/requirement-import": "workspace:*",
    "@pulseflow/ui-dsl": "workspace:*",
    "@vue/compiler-sfc": "^3.5.43",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "fflate": "^0.8.3",
    "tsx": "^4.20.5"
  }
}
