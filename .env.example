# Copy to .env for local development, then replace each placeholder.
PULSEFLOW_WORKSPACE_TOKEN=replace-with-a-long-random-workspace-token
PULSEFLOW_DB_PATH=./data/pulseflow.sqlite

# OpenAI-compatible Chat Completions service. The API appends /chat/completions.
PULSEFLOW_MODEL_BASE_URL=https://model.example.invalid/v1
PULSEFLOW_MODEL_NAME=replace-with-model-name
PULSEFLOW_MODEL_API_KEY=replace-with-model-api-key

# Optional CLI defaults when running `pulseflow pull`.
PULSEFLOW_URL=http://localhost:3000
PULSEFLOW_TOKEN=replace-with-workspace-token
