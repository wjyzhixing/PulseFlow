# Copy to .env for local development, then replace each placeholder.
PULSEFLOW_WORKSPACE_TOKEN=replace-with-a-long-random-workspace-token
PULSEFLOW_DB_PATH=./data/pulseflow.sqlite
# Relative paths are resolved from the PulseFlow repository root.
PULSEFLOW_SKILLS_DIR=./.agents/skills

# OpenAI-compatible Chat Completions service. The API appends /chat/completions.
PULSEFLOW_MODEL_BASE_URL=https://model.example.invalid/v1
PULSEFLOW_MODEL_NAME=replace-with-model-name
PULSEFLOW_MODEL_API_KEY=replace-with-model-api-key

# Optional image-to-UI-DSL vision settings. The configured model must accept
# OpenAI-compatible image_url messages and JSON output. TokenRhythm example:
# qwen3.7-flash. These default to the text service above.
# PULSEFLOW_VISION_API_URL=https://vision.example.invalid/v1
# PULSEFLOW_VISION_MODEL_NAME=qwen3.7-flash
# PULSEFLOW_VISION_API_KEY=replace-with-vision-api-key
# PULSEFLOW_VISION_TIMEOUT_MS=90000

# Optional image generation settings. By default, image generation uses the same
# OpenAI-compatible /chat/completions endpoint and API key as text generation.
# PULSEFLOW_IMAGE_API_URL=https://model.example.invalid/v1/chat/completions
# PULSEFLOW_IMAGE_API_MODE=openai-chat-completions # or openai-images, dashscope-native, volcengine-ark-images
# PULSEFLOW_IMAGE_MODEL_NAME=qwen-image-2.0
# PULSEFLOW_IMAGE_API_KEY=replace-with-image-api-key # defaults to PULSEFLOW_MODEL_API_KEY
# PULSEFLOW_IMAGE_TIMEOUT_MS=120000
# PULSEFLOW_IMAGE_RESULT_HOSTS=images.example.invalid,cdn.example.invalid
# Volcengine Ark Seedream example (the image key is separate from the text provider key):
# PULSEFLOW_IMAGE_API_URL=https://ark.cn-beijing.volces.com/api/plan/v3/images/generations
# PULSEFLOW_IMAGE_API_MODE=volcengine-ark-images
# PULSEFLOW_IMAGE_MODEL_NAME=doubao-seedream-5.0-lite
# PULSEFLOW_IMAGE_API_KEY=replace-with-ark-api-key
# PULSEFLOW_IMAGE_RESULT_HOSTS=ark-acg-cn-beijing.tos-cn-beijing.volces.com
# PULSEFLOW_ASSET_DIR=./data/assets

# Optional CLI defaults when running `pulseflow pull`.
PULSEFLOW_URL=http://localhost:3000
PULSEFLOW_TOKEN=replace-with-workspace-token
