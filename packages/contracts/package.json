{
  "name": "@pulseflow/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config ../../vitest.config.ts packages/contracts/test",
    "coverage": "vitest run --coverage --config ../../vitest.config.ts packages/contracts/test"
  },
  "dependencies": {
    "@pulseflow/ui-dsl": "workspace:*"
  }
}
